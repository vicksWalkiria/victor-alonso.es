# Opciones del servidor
Options -Indexes

# ─── HTTPS y www canónico ─────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0. 410 Gone: URLs permanentemente eliminadas (deben ir ANTES del trailing slash)
  RewriteRule ^cdn-cgi/l/email-protection/?$ - [G,L]
  RewriteRule ^apple-app-site-association/?$ - [G,L]
  RewriteRule ^\.well-known/apple-app-site-association/?$ - [G,L]

  # 0.4. 301 Redirects: URLs cambiadas y consolidación de desarrollo WordPress en Walkiria Apps
  RewriteRule ^herramientas/editor-gps-imagenes/?$ /herramientas/editor-metadatos-imagenes/ [R=301,L]
  RewriteRule ^servicios/seo-(albacete|local)(\.php|/?)$ / [R=301,L]
  RewriteRule ^servicios/desarrollo-wordpress(\.php|/?)$ https://walkiriaapps.com/servicios/desarrollo-wordpress/ [R=301,L]

  # 0.5. Bloqueo inmediato de escaneos de vulnerabilidades y ficheros internos (CMS, Git, Env, Data, Scratch, Docs y Scripts internos)
  #      Evita sobrecargar PHP-FPM y devuelve 403 Forbidden sin afectar openapi.json, llms*.txt, robots.txt, sitemap.xml, api.php ni mcp.php
  RewriteCond %{REQUEST_URI} ^/(wp-login\.php|wp-admin|xmlrpc\.php|wp-content|wp-includes|wp-config\.php|wp-json|\.env|\.git|\.oracle_ssh\.txt|\.user\.ini|data|scratch|includes|herramientas/(auditor-v2|gsc-report-engine|log-report-engine)|admin/controller|shell\.php|webshell\.php|phpinfo\.php|info\.php|backup\.(sql|zip|tar\.gz|rar)|actuator/health)(/.*)?$ [NC,OR]
  RewriteCond %{REQUEST_URI} (^|/)(test-puppeteer[^/]*\.js|gsc_[^/]*\.json|walkiria_gsc\.json|\.~lock\..*)$ [NC,OR]
  RewriteCond %{REQUEST_URI} \.(csv|sql|log|lock)$ [NC]
  RewriteRule ^ - [F,L]

  RewriteCond %{REQUEST_URI} !^/\.well-known/agent-skills/ [NC]
  RewriteCond %{REQUEST_URI} \.md$ [NC]
  RewriteRule ^ - [F,L]

  # 1. Forzar HTTPS (omitir en localhost)
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Forzar www (omitir en localhost)
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3. Eliminar doble barra
  RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
  RewriteRule . %1/%2 [R=301,L]

  # 3.4. Excluir .well-known y endpoints API/MCP de redirecciones forzadas de trailing slash
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^(api|mcp)\.php$ - [L]

  # 3.5. Forzar barra final (trailing slash) en peticiones GET/HEAD si no es un archivo físico ni extensión estática (omitir redirect https en localhost)
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
  RewriteCond %{REQUEST_URI} !^/(api|mcp)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.(ico|png|jpg|jpeg|webp|svg|css|js|xml|json|txt|pdf|woff2?)$ [NC]
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteCond %{HTTP_HOST} ^localhost [NC]
  RewriteRule ^(.*)$ http://%{HTTP_HOST}/$1/ [R=301,L]

  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
  RewriteCond %{REQUEST_URI} !^/(api|mcp)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.(ico|png|jpg|jpeg|webp|svg|css|js|xml|json|txt|pdf|woff2?)$ [NC]
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # 4. Redirigir .php → URL limpia (301 permanente en GET/HEAD, excluyendo api.php y mcp.php)
  #    Evita tocar archivos reales como favicon.png, social.webp, etc.
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
  RewriteCond %{REQUEST_URI} !^/(api|mcp)\.php$ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]

  # 5. Reescritura interna: URL limpia → archivo .php
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# ─── Compresión Gzip ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ─── Caché de assets estáticos ────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp          "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 month"
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon        "access plus 1 year"
  ExpiresByType application/xml     "access plus 1 week"
</IfModule>

# ─── Cabeceras de seguridad ───────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  # AI Agent Discovery Link Headers (RFC 8288 / RFC 9727)
  Header set Link '</.well-known/api-catalog>; rel="api-catalog", </llms.txt>; rel="describedby"; type="text/markdown", </llms-full.txt>; rel="alternate"; type="text/markdown", </.well-known/agent-skills/index.json>; rel="agent-skills", </.well-known/ai-catalog.json>; rel="ai-catalog"'
  Header append Vary "Accept"
  # Strict-Transport-Security solo si el certificado es permanente
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ─── Formatos y Cabeceras para Agentes de IA ─────────────────────────────────
<Files "api-catalog">
  ForceType application/linkset+json
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Content-Type "application/linkset+json; charset=utf-8"
  </IfModule>
</Files>

<FilesMatch "^(llms\.txt|llms-full\.txt)$">
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Content-Type "text/plain; charset=utf-8"
  </IfModule>
</FilesMatch>

<FilesMatch "^(oauth-protected-resource|oauth-authorization-server|openid-configuration|server-card\.json|server-cards\.json|mcp\.json|agent-card\.json|ai-catalog\.json|index\.json|jwks\.json)$">
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Content-Type "application/json; charset=utf-8"
  </IfModule>
</FilesMatch>


# ─── Proteger archivos sensibles ──────────────────────────────────────────────
<FilesMatch "^\.(?!well-known)">
  Order allow,deny
  Deny from all
</FilesMatch>

<FilesMatch "(config\.php|composer\.json|composer\.lock|\.env)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Bloquear acceso directo a /includes/
<IfModule mod_rewrite.c>
  RewriteRule ^includes/ - [F,L]
</IfModule>

# ─── Página de error personalizada (opcional) ─────────────────────────────────
# ErrorDocument 404 /404.php
